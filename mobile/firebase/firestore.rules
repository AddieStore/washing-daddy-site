rules_version = '2';
// Washing Daddy: customer app, washer app and the approval page (/admin/). Shape: .notes/sync-contract.md.
// Everyone signs in with their phone number (SMS OTP), so request.auth.token.phone_number is the person.
// Washers can also sign in with phone + PIN (n8n workflow 12 mints a custom token for the SAME Firebase user, which
// carries the same phone_number), so nothing below may depend on how the person signed in (sign_in_provider).
//   admins     the numbers in ADMINS below: approve washers, activate customers, see everything
//   washers    washers/{+91number}; a washer can do nothing until an admin sets status 'approved'
//   customers  customers/{+91number}; sees live washes only for the cars on an account an admin activated
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner and anyone else allowed to approve washers. Full number with +91.
    function ADMINS() { return ['+917701808924']; }

    function signedIn() { return request.auth != null && request.auth.token.phone_number is string; }
    function me() { return request.auth.token.phone_number; }
    function isAdmin() { return signedIn() && me() in ADMINS(); }
    function str(v, n) { return v is string && v.size() <= n; }
    function optStr(m, k, n) { return !(k in m) || m[k] == null || str(m[k], n); }
    function d() { return request.resource.data; }

    function washerPath() { return /databases/$(database)/documents/washers/$(me()); }
    function isWasher() {
      return signedIn() && exists(washerPath()) && get(washerPath()).data.status == 'approved';
    }
    function myRound() { return get(washerPath()).data.route_id; }

    function customerPath() { return /databases/$(database)/documents/customers/$(me()); }
    function isActiveCustomer() {
      return signedIn() && exists(customerPath()) && get(customerPath()).data.status == 'active';
    }
    function ownsReg(reg) {
      return signedIn() && exists(customerPath())
        && get(customerPath()).data.status == 'active'
        && reg in get(customerPath()).data.regs;
    }

    match /washers/{phone} {
      allow read: if isAdmin() || (signedIn() && phone == me());
      // a new washer signs up and waits: status must start as 'pending', with no round
      allow create: if isAdmin() || (signedIn() && phone == me()
        && d().keys().hasOnly(['phone', 'name', 'area', 'ref', 'status', 'created_at', 'updated_at'])
        && d().phone == me() && d().status == 'pending'
        && str(d().name, 60) && d().name.size() > 0 && optStr(d(), 'area', 80) && optStr(d(), 'ref', 12));
      allow update: if isAdmin()
        || (signedIn() && phone == me()
            && d().diff(resource.data).affectedKeys().hasOnly(['name', 'area', 'updated_at', 'last_seen_at', 'push_token', 'push_at'])
            && optStr(d(), 'push_token', 400) && optStr(d(), 'push_at', 40)
            && str(d().name, 60));
      allow delete: if isAdmin();
    }

    // The washer's kit (clothes, shampoo, spray guns, other materials). Append-only: the washer can add items but
    // never change or remove one; only an admin can correct the list. His ID records (Aadhaar last 4, police
    // clearance) and the clothes assigned to him live on washers/{phone}, which only an admin can write them to.
    match /washerkit/{phone} {
      allow read: if isAdmin() || (signedIn() && phone == me());
      allow create: if isAdmin() || (isWasher() && phone == me()
        && d().keys().hasOnly(['phone', 'items', 'updated_at'])
        && d().phone == me() && d().items is list && d().items.size() >= 1 && d().items.size() <= 10
        && optStr(d(), 'updated_at', 40));
      allow update: if isAdmin() || (isWasher() && phone == me()
        && d().keys().hasOnly(['phone', 'items', 'updated_at'])
        && d().phone == resource.data.phone
        && d().items is list
        && d().items.size() > resource.data.items.size()
        && d().items.size() <= resource.data.items.size() + 10
        && d().items.size() <= 300
        && d().items[0:resource.data.items.size()] == resource.data.items
        && optStr(d(), 'updated_at', 40));
      allow delete: if isAdmin();
    }

    // One photo per kit item (a small data: thumbnail), kept out of the kit list so that doc stays small.
    // Create only, by the washer it belongs to (or an admin); nobody can change or remove one except an admin.
    match /kitphotos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.phone == me());
      allow create: if isAdmin() || (isWasher()
        && d().keys().hasOnly(['phone', 'item', 'photo', 'at'])
        && d().phone == me() && str(d().item, 40) && id == me() + '_' + d().item
        && str(d().photo, 150000) && d().photo.size() > 0 && optStr(d(), 'at', 40));
      allow update, delete: if isAdmin();
    }

    // The washer's identity documents (Aadhaar front/back, PAN): one doc each, a photo or a PDF as a data: URL.
    // Uploaded by the washer while joining (so only signed in, not yet approved); readable by him and admins only.
    // He can replace one until an admin marks it 'verified'; only an admin can set status or remove one.
    match /washerdocs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.phone == me());
      allow create: if isAdmin() || (signedIn()
        && d().keys().hasOnly(['phone', 'kind', 'mime', 'name', 'data', 'at', 'status'])
        && d().phone == me() && d().kind in ['aadhaar_front', 'aadhaar_back', 'pan'] && id == me() + '_' + d().kind
        && d().mime in ['image/jpeg', 'image/webp', 'image/png', 'application/pdf']
        && str(d().name, 120) && str(d().data, 900000) && d().data.size() > 100 && optStr(d(), 'at', 40)
        && d().status == 'submitted');
      allow update: if isAdmin() || (signedIn() && resource.data.phone == me() && resource.data.status != 'verified'
        && d().keys().hasOnly(['phone', 'kind', 'mime', 'name', 'data', 'at', 'status'])
        && d().phone == me() && d().kind == resource.data.kind
        && d().mime in ['image/jpeg', 'image/webp', 'image/png', 'application/pdf']
        && str(d().name, 120) && str(d().data, 900000) && d().data.size() > 100 && optStr(d(), 'at', 40)
        && d().status == 'submitted');
      allow delete: if isAdmin();
    }

    match /customers/{phone} {
      allow read: if isAdmin() || (signedIn() && phone == me());
      // a new customer signs up as 'new'; an admin checks the car and makes the account 'active'
      allow create: if isAdmin() || (signedIn() && phone == me()
        && d().keys().hasOnly(['phone', 'name', 'area', 'status', 'cars', 'regs', 'since', 'created_at', 'updated_at'])
        && d().phone == me() && d().status == 'new'
        && str(d().name, 80) && optStr(d(), 'area', 80) && optStr(d(), 'since', 40)
        && optStr(d(), 'created_at', 40) && optStr(d(), 'updated_at', 40) && d().cars is list && d().cars.size() <= 5
        && d().regs is list && d().regs.size() <= 5);
      // the customer can change their name and preferences, and ask for another car (an admin adds it)
      allow update: if isAdmin()
        || (signedIn() && phone == me()
            && d().diff(resource.data).affectedKeys().hasOnly(['name', 'prefs', 'requested_cars', 'updated_at'])
            && str(d().name, 80)
            && (!('requested_cars' in d()) || (d().requested_cars is list && d().requested_cars.size() <= 5)));
      allow delete: if isAdmin();
    }

    // a customer's own car photo, stored as carphotos/{+91number}_{carId} (kept out of the account doc)
    match /carphotos/{id} {
      allow read: if isAdmin() || (signedIn() && id.split('_')[0] == me());
      allow create: if isActiveCustomer() && id.split('_')[0] == me() && id.matches('^[+0-9]{13}_[A-Za-z0-9]{1,16}$')
        && d().keys().hasOnly(['photo', 'updated_at'])
        && d().photo is string && d().photo.size() <= 400000
        && str(d().updated_at, 40);
      allow update: if isActiveCustomer() && id.split('_')[0] == me() && id.matches('^[+0-9]{13}_[A-Za-z0-9]{1,16}$')
        && d().diff(resource.data).affectedKeys().hasOnly(['photo', 'updated_at'])
        && d().photo is string && d().photo.size() <= 400000
        && str(d().updated_at, 40);
      allow delete: if isAdmin();
    }

    match /washes/{id} {
      allow read: if isAdmin() || isWasher() || ownsReg(resource.data.reg);
      // a washer writes only his own round's docs, cannot take over a doc another round already wrote,
      // and cannot turn a finished wash back into an unfinished one
      allow create, update: if (isAdmin() || (isWasher() && d().washer_id == myRound()
                                              && (resource == null || (resource.data.washer_id == myRound()
                                                  && (resource.data.status != 'done' || d().status == 'done')))))
        && id == d().date + '_' + d().reg
        && str(d().washer_id, 40)
        && d().status in ['scheduled', 'on_the_way', 'arrived', 'washing', 'done', 'skipped'];
      allow delete: if isAdmin();
    }

    // The morning check-in ("Hub pahunch gaya"): one doc per washer per day, created once by the washer, seen live by admins.
    match /checkins/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.phone == me());
      allow create: if isAdmin() || (isWasher()
        && d().keys().hasOnly(['phone', 'name', 'date', 'at'])
        && d().phone == me() && str(d().date, 10) && id == d().date + '_' + me()
        && str(d().name, 80) && str(d().at, 40));
      allow update, delete: if isAdmin();
    }

    match /requests/{id} {
      allow read: if isAdmin() || isWasher() || ownsReg(resource.data.reg);
      allow create: if (isAdmin() || ownsReg(d().reg))
        && d().keys().hasOnly(['reg', 'kind', 'text', 'spots', 'from', 'to', 'created_at', 'status'])
        && (!('spots' in d()) || (d().spots is list && d().spots.size() <= 20))
        && optStr(d(), 'from', 10) && optStr(d(), 'to', 10) && optStr(d(), 'created_at', 40)
        && str(d().reg, 20)
        && d().kind in ['note', 'rewash', 'skip_tomorrow', 'pause']
        && d().status == 'open'
        && optStr(d(), 'text', 1000);
      // the washer app only moves the status along
      allow update: if (isAdmin() || isWasher())
        && d().diff(resource.data).affectedKeys().hasOnly(['status', 'seen_at', 'done_at'])
        && d().status in ['open', 'seen', 'done'];
      allow delete: if isAdmin();
    }

    // a car the washer sold himself, waiting for the owner to accept it and put it in the book.
    // The washer may put it on his own round; only an admin may approve it or change the fee.
    match /newcars/{reg} {
      allow read: if isAdmin() || (isWasher() && resource.data.washer_id == myRound());
      allow create: if isAdmin() || (isWasher()
        && d().keys().hasOnly(['reg', 'plate', 'model', 'area', 'plan', 'fee', 'customer_name',
                               'customer_phone', 'washer_id', 'added_by', 'status', 'note',
                               'created_at', 'updated_at'])
        && d().washer_id == myRound() && d().added_by == me() && d().status == 'pending'
        && d().reg == reg && d().reg.matches('^[A-Z0-9]{4,12}$')
        && str(d().plate, 20) && str(d().model, 60) && d().model.size() > 0
        && optStr(d(), 'area', 80) && optStr(d(), 'plan', 20) && optStr(d(), 'note', 300)
        && optStr(d(), 'customer_name', 80) && optStr(d(), 'customer_phone', 20)
        && d().fee is number && d().fee >= 0 && d().fee <= 20000);
      // the washer can correct what he typed while it is still pending; the owner decides the rest
      allow update: if isAdmin()
        || (isWasher() && resource.data.status == 'pending' && resource.data.washer_id == myRound()
            && d().diff(resource.data).affectedKeys().hasOnly(
                 ['plate', 'model', 'area', 'plan', 'customer_name', 'customer_phone', 'note', 'updated_at'])
            && str(d().model, 60) && d().model.size() > 0);
      allow delete: if isAdmin();
    }

    // an extra job the owner gives a washer: a one-off wash or a detail, with its own price
    match /ondemand/{id} {
      allow read: if isAdmin() || isWasher()
        || ownsReg(resource.data.reg)
        || (signedIn() && resource.data.customer_id == me());
      allow create: if isAdmin()
        || (isActiveCustomer()
            && d().keys().hasOnly(['service', 'service_id', 'price', 'paid', 'pay_ref', 'car', 'reg', 'area',
                                   'phone', 'customer_id', 'status', 'washer_id', 'created_at', 'date'])
            && d().customer_id == me() && d().phone == me()
            && d().status == 'new' && d().washer_id == ''
            && d().service_id in ['wash', 'deep', 'exclusive']
            && d().price == {'wash': 199, 'deep': 800, 'exclusive': 2100}[d().service_id]
            && str(d()['service'], 80) && optStr(d(), 'car', 80) && optStr(d(), 'reg', 20)
            && optStr(d(), 'area', 120) && optStr(d(), 'pay_ref', 80) && optStr(d(), 'created_at', 40)
            && optStr(d(), 'date', 10) && d().paid is bool);
      allow update: if isAdmin()
        || (isWasher() && (resource.data.washer_id == myRound() || resource.data.washer_id == '')
            && d().washer_id == myRound()          // a claim puts his own round on the job, nobody else's
            && d().diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'started_at', 'finished_at', 'photo', 'photo_at', 'washer_note', 'updated_at',
                  'washer_id', 'declined_at'])
            && d().status in ['new', 'doing', 'done', 'declined']
            && (!('photo' in d()) || d().photo == null || (d().photo is string && d().photo.size() <= 400000))
            && optStr(d(), 'washer_note', 300));
      allow delete: if isAdmin();
    }

    match /locations/{washerId} {
      // the doc id is the washer's ROUND id (what both apps write), not his phone number
      allow read: if isAdmin() || isWasher() || isActiveCustomer();
      allow create, update: if isWasher() && washerId == myRound()
        && d().keys().hasOnly(['lat', 'lng', 'accuracy', 'washer_id', 'updated_at'])
        && d().lat is number && d().lng is number && d().washer_id == washerId && optStr(d(), 'updated_at', 40);
      allow delete: if isAdmin() || (isWasher() && washerId == myRound());
    }

    match /ratings/{id} {
      allow read: if isAdmin() || isWasher() || ownsReg(resource.data.reg);
      allow write: if (isAdmin() || ownsReg(d().reg))
        && d().keys().hasOnly(['reg', 'date', 'stars', 'at'])
        && id == d().date + '_' + d().reg && optStr(d(), 'at', 40)
        && d().stars is int && d().stars >= 1 && d().stars <= 5;
    }

    // Customer complaints / feedback about a wash (customer app -> manager in the approvals page, and the washer).
    // washer_id is the washer's ROUND id (route_id), the same key washes/newcars/ondemand carry. '' when the customer
    // app did not know the washer yet (the manager still sees it). Doc id == d().id.
    //   customer  creates one for a car on his own active account, under his own number, status 'open';
    //             reads his own. Cannot change or delete it.
    //   washer    reads the ones on his round; may only move 'open' -> 'seen' (+ seen_at, updated_at).
    //   admin     reads all; may set status, manager_note, seen_at, resolved_at, updated_at (nothing else).
    // The No Complaint Bonus (WD Partner rewards) counts open/seen/resolved ones in the month; 'invalid' is not counted.
    function complaintFields() {
      return ['id', 'date', 'month', 'reg', 'washer_id', 'customer_phone', 'customer_name', 'text', 'kind', 'stars',
              'status', 'manager_note', 'created_at', 'seen_at', 'resolved_at', 'updated_at'];
    }
    function nullOrStr(m, k, n) { return !(k in m) || m[k] == null || str(m[k], n); }
    match /complaints/{id} {
      allow read: if isAdmin()
        || (isWasher() && resource.data.washer_id == myRound())
        || (signedIn() && resource.data.customer_phone == me());
      allow create: if ownsReg(d().reg)
        && d().keys().hasOnly(complaintFields())
        && d().keys().hasAll(['id', 'date', 'month', 'reg', 'washer_id', 'customer_phone', 'text', 'kind', 'status', 'created_at'])
        && d().id == id && id.matches('^[A-Za-z0-9_-]{6,80}$')
        && d().customer_phone == me()
        && str(d().reg, 20) && str(d().washer_id, 40)
        && d().month is string && d().month.matches('^[0-9]{4}-[0-9]{2}$')
        && d().date is string && d().date.matches('^' + d().month + '-[0-9]{2}$')
        && str(d().text, 500) && d().text.size() > 0
        && d().kind in ['quality', 'late', 'behaviour', 'damage', 'other']
        && (!('stars' in d()) || d().stars == null || (d().stars is int && d().stars >= 1 && d().stars <= 5))
        && optStr(d(), 'customer_name', 80)
        && d().status == 'open'
        && (!('manager_note' in d()) || d().manager_note == null || d().manager_note == '')
        && (!('seen_at' in d()) || d().seen_at == null)
        && (!('resolved_at' in d()) || d().resolved_at == null)
        && str(d().created_at, 40) && nullOrStr(d(), 'updated_at', 40);
      allow update: if (isAdmin()
            && d().diff(resource.data).affectedKeys().hasOnly(['status', 'manager_note', 'seen_at', 'resolved_at', 'updated_at'])
            && d().status in ['open', 'seen', 'resolved', 'invalid']
            && nullOrStr(d(), 'manager_note', 300) && nullOrStr(d(), 'seen_at', 40)
            && nullOrStr(d(), 'resolved_at', 40) && nullOrStr(d(), 'updated_at', 40))
        || (isWasher() && resource.data.washer_id == myRound() && resource.data.status == 'open'
            && d().diff(resource.data).affectedKeys().hasOnly(['status', 'seen_at', 'updated_at'])
            && d().status == 'seen' && str(d().seen_at, 40) && nullOrStr(d(), 'updated_at', 40));
      allow delete: if isAdmin();
    }

    // Washer sign-in PINs (phone + PIN login, n8n workflow 12). One doc per washer: washerpins/{+91number} =
    // {salt, hash (PBKDF2-SHA256, 150000 iterations), active, fails, locked_until, updated_at}. Never the PIN itself.
    // Only an admin (the approvals page) reads or writes it; n8n checks PINs with a service account, which skips rules.
    // Washers cannot read their own: the hash must never reach a phone.
    match /washerpins/{id} {
      allow read, write: if isAdmin();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
