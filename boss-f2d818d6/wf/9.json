    {
      "parameters": {
        "jsCode": "// Google ne jo number diya wahi sach hai.\nconst res = $json;\nconst user = (res.users && res.users[0]) || {};\nconst e164 = String(user.phoneNumber || '');\nconst phone = e164.replace(/\\D/g, '').slice(-10);\n\nif (phone.length !== 10) throw new Error('No verified phone on this token');\n\nconst b = $('Customer aaya').first().json.body || {};\nreturn [{ json: {\n  phone: phone,\n  action: String(b.action || 'me'),\n  num: String(b.num || '').slice(0, 20),\n  car: String(b.car || '').slice(0, 40),\n  name: String(b.name || '').slice(0, 60),\n  area: String(b.area || '').slice(0, 120),\n  plan: String(b.plan || '').slice(0, 40),\n  amount: Number(b.amount) || 0,\n  text: String(b.text || '').slice(0, 400)\n}}];"
      },
