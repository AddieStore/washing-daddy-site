    {
      "parameters": {
        "jsCode": "// Sirf is phone ki cars. Baaki kisi ka data kabhi nahi.\nconst me = $('Kaun hai').first().json;\n\nconst text = (p) => {\n  if (p == null) return '';\n  if (Array.isArray(p)) return p.map(x => (x && (x.plain_text || x.name || x.text)) || x).join(' ').trim();\n  if (typeof p === 'object') return String(p.name || p.plain_text || p.start || '').trim();\n  return String(p).trim();\n};\nconst dateOf = (p) => {\n  if (!p) return '';\n  if (typeof p === 'string') return p;\n  if (Array.isArray(p)) p = p[0];\n  if (p && typeof p === 'object') return String(p.start || (p.date && p.date.start) || '');\n  return '';\n};\nconst num = (v) => { const n = Number(v); return isNaN(n) ? 0 : n; };\nconst sq = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst last10 = (s) => String(s || '').replace(/\\D/g, '').slice(-10);\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });\n\nconst mine = [];\nconst washes = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n  const isLog = ('property_round_date' in p) || ('property_done_at' in p);\n\n  if (isLog) {\n    washes.push({\n      num: sq(text(p.property_car_number)),\n      day: text(p.property_round_date) || dateOf(p.property_done_at).slice(0, 10),\n      at: dateOf(p.property_done_at),\n      photo: text(p.property_photo_id),\n      washer: text(p.property_washer),\n      skipped: p.property_skipped === true,\n      services: (function(){\n        const s = p.property_services_done;\n        if (Array.isArray(s)) return s.map(x => (x && (x.name || x)) || '').filter(Boolean);\n        return [];\n      })()\n    });\n    continue;\n  }\n\n  if (!('property_monthly_fee' in p)) continue;\n  if (last10(text(p.property_phone)) !== me.phone) continue;\n  if (text(p.property_account_status) === 'Churned') continue;\n\n  const paidTo = dateOf(p.property_service_paid_up_to).slice(0, 10) || null;\n  mine.push({\n    car: text(p.property_car) || text(p.name),\n    num: text(p.property_car_number),\n    key: sq(text(p.property_car_number)),\n    area: text(p.property_area),\n    level: text(p.property_service_level) || 'WD Standard',\n    fee: num(p.property_monthly_fee),\n    owes: num(p.property_owes_now),\n    paidTo: paidTo,\n    overdue: !!(paidTo && paidTo < today)\n  });\n}\n\nfor (const c of mine) {\n  const his = washes\n    .filter(w => w.key !== '' || true)\n    .filter(w => w.num && c.key && (w.num === c.key || w.num.endsWith(c.key) || c.key.endsWith(w.num)))\n    .filter(w => !w.skipped)\n    .sort((a, b) => String(b.at || b.day).localeCompare(String(a.at || a.day)));\n\n  const t = his.find(w => w.day === today);\n  c.today = t ? { at: t.at, photo: t.photo, washer: t.washer, services: t.services } : null;\n  c.recent = his.filter(w => w.day !== today).slice(0, 8)\n                .map(w => ({ day: w.day, photo: w.photo }));\n  delete c.key;\n}\n\nreturn [{ json: { phone: me.phone, cars: mine, date: today } }];"
      },
